{
  "name": "netyard",
  "version": "1.0.0",
  "private": true,
  "description": "NetYard — stand up a small-business network without Microsoft Server. A First Deploy AI product.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && NODE_NO_WARNINGS=1 node --experimental-strip-types scripts/write-route-html.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:netlify": "netlify dev"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "stripe": "^18.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
