# Optional: sign release builds with YOUR OWN key so future updates can be
# installed over the top on the Fold. Copy this file to keystore.properties
# (which is gitignored) and fill in real values. If you skip this, release
# builds fall back to the Android debug key, which is fine for personal
# sideloading but will require an uninstall/reinstall if you later switch keys.
#
# Generate a keystore once:
#   keytool -genkeypair -v -keystore fold-companion-release.jks \
#     -alias fold -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=fold-companion-release.jks
storePassword=CHANGE_ME
keyAlias=fold
keyPassword=CHANGE_ME
