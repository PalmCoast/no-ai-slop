# Copy to .env for `netlify dev`. Every variable is optional for local
# development; Stateside tells you what is missing.

# Payments. Unset: job posting runs in demo mode (no charge, clearly labelled)
# ONLY when ALLOW_DEMO_PAYMENTS=true. In production set all three.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_DEMO_PAYMENTS=true

# Price of one job posting in US cents. Default 1000 ($10).
JOB_POST_PRICE_CENTS=1000

# Comma-separated emails that are granted the admin role on signup or login.
ADMIN_EMAILS=

# Hours after publication during which only veterans can see a new posting.
VETERAN_EARLY_ACCESS_HOURS=48

# Public URL used in Checkout success/cancel links. Defaults to the request origin.
SITE_URL=http://localhost:8888

# Local database file location used when NETLIFY_DB_URL is absent.
STATESIDE_DATA_DIR=.data
