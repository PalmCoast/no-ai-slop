{
  "manifest_version": 3,
  "name": "AskYard Rep",
  "version": "1.0.0",
  "description": "Look up a name. See the AskYard reputation meter the moment something rough is posted in public.",
  "action": {
    "default_title": "AskYard Rep",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://askyard.firstdeploy.ai/*",
    "https://marquee.firstdeploy.ai/*"
  ]
}
