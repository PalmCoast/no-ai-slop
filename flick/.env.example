# Flick env (no secrets in git)

SITE_URL=https://useflick.netlify.app

# Required to sell Lights / Marquee
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. If unset, Checkout uses inline price_data ($19/mo and $99 founder).
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_FOUNDER=

# Local only. Never in production. Issues FLICK-DEMO-* keys with no charge.
ALLOW_DEMO_PAYMENTS=true
