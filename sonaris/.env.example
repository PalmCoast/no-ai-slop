# Copy to .env for `netlify dev`. Every variable is optional; Sonaris runs in
# demo mode when a provider is missing and tells you what to add.

# Language model (OpenAI-compatible chat completions). Leave both unset to use
# the Netlify AI Gateway, which injects them after the first production deploy.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Text to speech. ElevenLabs is used for personas with an elevenlabs_voice_id,
# OpenAI TTS for personas with an openai_voice. Neither set: browser speech.
ELEVENLABS_API_KEY=

# Payments. Unset: checkout returns a demo license (clearly labelled).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# Public URL used in Checkout success/cancel links. Defaults to the request origin.
SITE_URL=http://localhost:8888

# Default end-of-utterance silence in milliseconds (the console exposes a slider).
SONARIS_SILENCE_MS=900
